# =========================
# DataTripwire Environment
# =========================

NODE_ENV=development

# Backend
BACKEND_PORT=3000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# PostgreSQL
POSTGRES_DB=datatripwire
POSTGRES_USER=datatripwire
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_PORT=5432

DATABASE_URL=postgresql://datatripwire:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/datatripwire

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# Backup
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=20

# Security incident email alerts (leave blank until SMTP is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_ALERT_RECIPIENT=
