# =========================
# DataTripwire Environment
# =========================

NODE_ENV=development
# Must be explicitly true to create prototype-only demo users/resources; disabled in production.
ENABLE_DEMO_SEED=true

# Backend
BACKEND_PORT=3000
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m

# Exact browser origins allowed to call the backend; set deployed HTTPS origins in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=datatripwire
POSTGRES_USER=datatripwire
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_PORT=5432

DATABASE_URL=postgresql://datatripwire:CHANGE_ME_TO_A_STRONG_PASSWORD@postgres:5432/datatripwire

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
# Exact browser origins allowed to call AI directly; production should normally
# leave this empty and route AI requests through the authenticated backend.
AI_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Docker serves the built app through its web server)
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000
VITE_AI_SERVICE_URL=http://localhost:8000

# Backup
BACKUP_DIR=/app/backups
BACKUP_RETENTION_COUNT=20

# Security incident email alerts (leave blank until SMTP is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_ALERT_RECIPIENT=
