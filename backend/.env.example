APP_NAME=DataTripwire Backend
APP_ENV=development
APP_VERSION=0.2.0
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./datatripwire.db
JWT_SECRET=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
SEED_DEMO_DATA=true
