# Local development defaults. Do not upload real .env files or secrets to Git.
# For local development, use the values below.
VITE_API_BASE_URL=http://localhost:3000
# Leave blank to keep the AI service private and avoid direct browser access.
VITE_AI_SERVICE_URL=
VITE_DEMO_MODE=false

# Vercel Production/Preview environment variables (set in Vercel UI, not committed):
# VITE_API_BASE_URL=https://your-deployed-backend.example.com
# Configure backend CORS_ORIGINS to include the exact Vercel production origin.
